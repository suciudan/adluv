[Unit]
Description=AdLuv site
After=network.target

[Service]
Type=simple
User=adluv
Group=adluv
WorkingDirectory=/srv/adluv
Environment=NODE_ENV=production
EnvironmentFile=/etc/adluv/adluv.env
ExecStart=/usr/bin/yarn workspace @adluv/site start
Restart=on-failure

[Install]
WantedBy=multi-user.target
