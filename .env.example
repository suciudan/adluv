NODE_ENV=development

# Public origins
SITE_URL=http://127.0.0.1:3000
APP_URL=http://127.0.0.1:3001
CMS_URL=http://127.0.0.1:3002
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001
NEXT_PUBLIC_CMS_URL=http://127.0.0.1:3002
CDN_URL=http://127.0.0.1:3101
NEXT_PUBLIC_CDN_URL=http://127.0.0.1:3101
# Optional absolute path; blank uses apps/cdn/storage. Use the same path for all services.
CDN_STORAGE_ROOT=
AD_ASSET_CDN_URL=
NEXT_PUBLIC_AD_ASSET_CDN_URL=
CDN_HOST=127.0.0.1
CDN_PORT=3101

# Auth cookie overrides
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=

# Local MySQL
DATABASE_URL=mysql://root:root@127.0.0.1:3306/adluv
# E2E tests truncate their database. Always point this at a disposable schema.
E2E_DATABASE_URL=mysql://root:root@127.0.0.1:3306/adluv_e2e

# Better Auth
BETTER_AUTH_URL=http://127.0.0.1:3001
BETTER_AUTH_SECRET=replace_me_with_a_long_random_secret

# Integrations
WEBSCRAPINGAPI_API_KEY=
WEBSCRAPINGAPI_PROXY_URL=
WEBSCRAPINGAPI_PROXY_USERNAME=
WEBSCRAPINGAPI_PROXY_PASSWORD=
RESEND_API_KEY=
RESEND_FROM=alerts@example.com

# Proxy lab
# Select one provider or compare several comma-separated providers.
PROXY_LAB_PROVIDER=direct
PROXY_LAB_PROVIDERS=
PROXY_LAB_OUTPUT=
PROXY_LAB_COUNTRY=us
PROXY_LAB_IP_URL=http://api.ipify.org?format=json
PROXY_LAB_PROXY_FILE=
GOOGLE_RPC_PROXY_FILE=
# Preferred in production when env is written beside the app and no proxy file is deployed.
# Supports one proxy per line in the same formats as proxy files.
PROXIES_LIST=
GOOGLE_RPC_PROXY_LIST=
GOOGLE_RPC_PROXY_URLS=
META_PROXY_FILE=
META_PROXY_LIST=
META_PROXY_URLS=
PROXY_LAB_GOOGLE_QUERY=nike
PROXY_LAB_GOOGLE_ADVERTISER_ID=
PROXY_LAB_GOOGLE_PREVIEW_URL=
PROXY_LAB_META_QUERY=nike
PROXY_LAB_META_PAGE_ID=
PROXY_LAB_META_COUNTRY=GB
PROXY_LAB_LINKEDIN_COMPANY=openai

# Provider names are arbitrary. Use the name in PROXY_LAB_PROVIDER(S), then define:
# PROXY_PROVIDER_<NAME>_MODE=direct|http-proxy|webscrapingapi-proxy|webscrapingapi-rest
# PROXY_PROVIDER_<NAME>_URL=http://host:port
# PROXY_PROVIDER_<NAME>_USERNAME=
# PROXY_PROVIDER_<NAME>_PASSWORD=
# PROXY_PROVIDER_<NAME>_API_KEY=
# PROXY_PROVIDER_<NAME>_COUNTRY=us
# PROXY_PROVIDER_<NAME>_SESSION_ID=

# Example: compare direct, WebScrapingAPI REST, and a generic proxy.
# PROXY_LAB_PROVIDERS=direct,webscrapingapi-rest,my-proxy
# PROXY_PROVIDER_WEBSCRAPINGAPI_REST_MODE=webscrapingapi-rest
# PROXY_PROVIDER_WEBSCRAPINGAPI_REST_API_KEY=
# PROXY_PROVIDER_MY_PROXY_MODE=http-proxy
# PROXY_PROVIDER_MY_PROXY_URL=http://host:port
# PROXY_PROVIDER_MY_PROXY_USERNAME=
# PROXY_PROVIDER_MY_PROXY_PASSWORD=

# Leave WebScrapingAPI SESSION_ID empty for Google RPC checks unless you are
# specifically testing sticky sessions; WSA can fail HTTPS CONNECT with sessions.

# Worker scheduling
SYNC_CADENCE_MINUTES=720
SYNC_SCHEDULER_POLL_SECONDS=60
ACTIVE_AD_STATUS_CHECK_CADENCE_HOURS=24

# Backblaze B2 ad asset storage
B2_ENDPOINT=
B2_BUCKET_NAME=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=

# Brevo
BREVO_API_KEY=
BREVO_WAITLIST_LIST_ID=
DISCORD_WAITLIST_WEBHOOK_URL=

# Optional error notifications
DISCORD_ERROR_WEBHOOK_URL=

# Optional support chat (disabled unless your own website ID is configured)
CRISP_WEBSITE_ID=
CRISP_IDENTITY_VERIFICATION_SECRET=

# Optional analytics: the built-in /ingest proxy targets the PostHog EU region.
# Public values are embedded at build time. Never put a private API key here.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional video transcription
OPENAI_API_KEY=

# Optional MCP HTTP server and client token override
MCP_HOST=127.0.0.1
MCP_PORT=3010
MCP_BASE_URL=http://127.0.0.1:3010
MCP_ALLOWED_ORIGINS=http://127.0.0.1:3001
ADLUV_MCP_ACCESS_TOKEN=

# Optional loopback-only quick login, development mode only.
# Uses an existing account and resets its password to the explicit value below.
# Leave both blank to use the normal username/password form.
LOCAL_DEV_AUTH_USERNAME=
LOCAL_DEV_AUTH_PASSWORD=

# Optional marketing-site Google Tag Manager (disabled when blank)
GTM_CONTAINER_ID=
